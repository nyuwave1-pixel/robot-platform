# ── MEDIDERMA AI SKIN ANALYSIS ──────────────────────────────
# 분석은 브라우저(on-device)에서 실행되므로 외부 AI API 키가 필요하지 않습니다.

# 관리자 페이지(/admin) 비밀번호 (8자 이상). 비워 두면 관리자 기능 전체가 비활성화됩니다.
ADMIN_PASSWORD=
# 관리자 세션 쿠키 서명 키 (선택. 없으면 비밀번호에서 파생)
ADMIN_SECRET=

# 익명 통계·운영 설정·신고 저장소. 없으면 로컬 JSON 파일(.data/store.json)을 씁니다.
# 서버리스(Vercel 등)에서는 파일이 영속되지 않으므로 반드시 PostgreSQL 을 연결하세요. 스키마: db/schema.sql (자동 생성됨)
DATABASE_URL=
# 파일 저장소 위치 (선택)
DATA_DIR=

# (선택) Gemini AI 해설. 얼굴 사진이 Google 로 전송되는 기능이므로 반드시 '결제가 연결된 유료 등급' 키를 사용하세요.
# 무료 등급 키는 Google 이 전송 내용을 제품 개선·사람 검토에 사용할 수 있습니다 (https://ai.google.dev/gemini-api/terms).
# 키를 넣은 뒤 /admin → 'AI 모델·점수 기준'에서 유료 등급 확인과 사용을 켜야 동작합니다.
GEMINI_API_KEY=
# 모델 (기본 gemini-flash-latest)
GEMINI_MODEL=

# 개발·E2E 검증용 하네스(/dev/harness)를 프로덕션 빌드에서 여는 스위치. 운영에서는 설정하지 마세요.
ENABLE_DEV_HARNESS=
