# Same line endings on every PC (Windows + cloud sessions)
* text=auto
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh  text eol=lf
*.py  text eol=lf

# Unity text assets: merge as text, binary assets untouched
*.unity  text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset  text eol=lf merge=unityyamlmerge
*.meta   text eol=lf
*.mat    text eol=lf
*.anim   text eol=lf
*.controller text eol=lf

# Binary game assets
*.glb   binary
*.blend binary
*.fbx   binary
*.png   binary
*.jpg   binary
*.webp  binary
*.ogg   binary
*.mp3   binary
*.wav   binary
*.mp4   binary
*.webm  binary
*.jpeg  binary
*.zip   binary
*.ttf   binary
*.woff2 binary

# third-party packs stay byte-identical to the download (fetch scripts check SHA-256)
apps/unity-studio/Assets/ThirdParty/** -text
