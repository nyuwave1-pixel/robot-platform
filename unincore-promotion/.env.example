# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://promotion.unincore.com

# ---- Tracking (can also be set in /admin → Tracking; admin values take priority) ----
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Meta Conversions API (optional, server-side) ----
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# ---- Admin auth ----
# Long random string (>= 32 chars) used to sign admin session cookies.
ADMIN_SESSION_SECRET=
# Admin = full access (tracking IDs, users). Editor = content, links, promotions.
ADMIN_PASSWORD=
EDITOR_PASSWORD=

# ---- Storage (Upstash Redis REST / Vercel KV via Marketplace) ----
# Without these, local dev stores data in ./.data/*.json; production is read-only defaults.
KV_REST_API_URL=
KV_REST_API_TOKEN=
